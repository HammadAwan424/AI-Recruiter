# Fields that don't have ={value} needs to be explicitly set in .env to make the app work

# ──── Database Configuration (Default Fallback Provided) ────
DATABASE_URL=postgresql://postgres:12345@localhost:5432/airecruiter

# ──── Security & Authentication ────
SECRET_KEY=mysecretkey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ──── CORS Allowed Origins ────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ──── Mandatory AI Integrations (No Fallback) ────
GROQ_API_KEY=
